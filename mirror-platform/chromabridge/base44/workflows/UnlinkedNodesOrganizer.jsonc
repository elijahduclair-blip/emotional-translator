{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "unlinked_nodes_organizer",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "organize_unlinked": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "librarianOrganizeUnlinked",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Organize unlinked nodes",
            "description": "Librarian agent repairs orphans and flags stragglers"
          }
        }
      }
    ]
  },
  "name": "Unlinked Nodes Organizer",
  "description": "Every 10 minutes, tasks the Librarian agent with finding ColorNodes that have no parents or TrajectoryEdge connections, re-linking orphans by coordinate proximity, and flagging stragglers for review.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/10 * * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}